{
  "name": "super-backlog",
  "version": "0.10.2",
  "description": "One command to equip any project with Backlog.md + Superpowers, plus a Project Dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adam-s-k-i/super-backlog"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sbl": "dist/cli.js",
    "super-backlog": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "markdownlint-cli2 \"**/*.md\" && cspell --no-progress --no-summary \"**/*.md\"",
    "tasks": "backlog task list",
    "board": "backlog board",
    "browser": "backlog browser",
    "dashboard": "super-backlog dashboard",
    "screenshot": "npm run build && node scripts/capture-dashboard.mjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.2.0",
    "backlog.md": "^1.50.1",
    "cspell": "^10.1.1",
    "markdownlint-cli2": "^0.23.2",
    "super-backlog": "file:.",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "@vitejs/plugin-vue": {
        "vite": "^6.4.3",
        "esbuild": "^0.25.0"
      }
    },
    "vitest": {
      "vite": "^8.2.2",
      "@vitest/mocker": {
        "vite": "^8.2.2"
      }
    }
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
