{
  "name": "super-backlog",
  "version": "1.11.0",
  "description": "One command to equip any project with Backlog.md + Superpowers, plus a Project Dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adam-s-k-i/super-backlog"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "sbl": "dist/bin.js",
    "super-backlog": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "markdownlint-cli2 \"**/*.md\" && cspell --no-progress --no-summary \"**/*.md\"",
    "tasks": "backlog task list",
    "board": "backlog board",
    "browser": "backlog browser",
    "dashboard": "super-backlog dashboard",
    "screenshot": "npm run build && node scripts/capture-dashboard.mjs"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.11",
    "backlog.md": "^1.57.4",
    "cspell": "^10.6.0",
    "happy-dom": "21.0.4",
    "markdownlint-cli2": "^0.24.2",
    "super-backlog": "file:.",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.4"
    },
    "vitest": {
      "vite": "^6.4.4",
      "@vitest/mocker": {
        "vite": "^6.4.4"
      }
    },
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6"
  }
}
