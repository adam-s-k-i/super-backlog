        "planner",
        "executor",
        "hub",
      ],
      "role": "language, tsc build to dist/",
      "version": "7.0.2",
    },
    {
      "group": "Runtime",
      "name": "cross-spawn",
      "nodes": [
        "executor",
        "cli",
      ],
      "role": "the only runtime dependency",
