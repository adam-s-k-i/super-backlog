  "manifest": "package.json",
  "packageName": "super-backlog",
  "pitchHtml": "CLI kit that wires <b>Backlog.md</b> and <b>Superpowers</b> into any project: a binding agent pipeline with gates, glue skills, a live dashboard and a verified uninstall.",
  "project": "demo-project",
  "source": {
    "auto": [
      "Name, version and license from package.json",
      "212 source files (.ts .mjs) from git ls-files",
      "3 runtime and 9 development dependencies; versions from lockfiles where present",
      "14 releases from git version tags",
      "3 GitHub Actions workflows",
      "Open work from backlog task list",
    ],
    "curated": [
      "Pitch, 13 components, 14 connections, 4 flows",
      "4 highlights, 4 stack entries, 2 command groups",
      "1 task-to-component mappings (status comes from the backlog CLI)",
    ],
    "file": "backlog/docs/architecture.yml",
    "warnings": [],
  },
  "stack": [
    {
      "group": "Runtime",
      "name": "TypeScript",
      "nodes": [
