{
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": { "allowed_elements": ["details", "summary", "br"] },
    "MD041": false,
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/backlog/**",
    "**/.superpowers/**",
    "**/.worktrees/**",
    "**/docs/superpowers/plans/**",
    "**/CHANGELOG.md"
  ]
}
